---
import Page from "../layouts/Page.astro"
import Marquee from "../components/Marquee.astro"
import { Image } from "astro:assets"

import hoodie from "../media/hood.webp"
---

<style>
	/*
        Idea taken from hoodie (https://hoodb0.codeberg.page/)
    */
	#pronounce {
		background: linear-gradient(
				90deg,
				light-dark(oklch(0.6 0.15 226.51), oklch(0.8025 0.1203 226.51)) 0%,
				light-dark(oklch(0.65 0.12 6.32), oklch(0.8118 0.0912 6.32)) 25%,
				light-dark(oklch(0.8 0 0), oklch(1 0 0)) 50%,
				light-dark(oklch(0.65 0.12 6.32), oklch(0.8118 0.0912 6.32)) 75%,
				light-dark(oklch(0.6 0.15 226.51), oklch(0.8025 0.1203 226.51)) 100%
			)
			text;
		color: transparent;
	}
</style>

<Page description="im secretly a ghost">
	Pronouns: <a
		class="u-url highlightHover"
		href="https://en.wikipedia.org/wiki/Transgender#Transfeminine"
		class="u-pronoun"
		style="white-space:pre"
		id="pronounce"
	>
		<span class="p-x-pronoun-nominative">she</span>/<span class="p-x-pronoun-oblique">her</span>
	</a>
	<br />
	<article>
		<Marquee text="HELLO!" />
		<section>
			<span>
				I like software because hardware makes me remove my headphones. I'm very bad at
				summarising myself but I have been described by some friends as "calm but energetic"
				and that "i like horses."
			</span>
		</section>
	</article>
	<article>
		<Marquee text="HOODIE!" />
		<section>
			<figure>
				<Image width={128} height={128} src={hoodie} alt="vennie by shoritsu!" />
			</figure>
			<span>
				{
					Array.from({ length: 6 }, () => (
						<li>
							<a target="_blank" href="https://hood.pink">
								look!
							</a>
						</li>
					))
				}
			</span>
		</section>
	</article>
</Page>
