---
import Page from "../layouts/Page.astro"
import Marquee from "../components/Marquee.astro"
import { Image } from "astro:assets"

import miruna from "../media/miruna.avif"
import charli from "../media/charli.avif"
---

<style>
	/*
	        Idea taken from Miruna (https://hood.pink/)
	    */
	#pronounce {
		background: linear-gradient(
				90deg,
				light-dark(oklch(0.6 0.15 226.51), oklch(0.8025 0.1203 226.51)) 0%,
				light-dark(oklch(0.65 0.12 6.32), oklch(0.8118 0.0912 6.32)) 25%,
				light-dark(oklch(0.8 0 0), oklch(1 0 0)) 50%,
				light-dark(oklch(0.65 0.12 6.32), oklch(0.8118 0.0912 6.32)) 75%,
				light-dark(oklch(0.6 0.15 226.51), oklch(0.8025 0.1203 226.51)) 100%
			)
			text;
		color: transparent;
	}
</style>

<Page description="im secretly a ghost">
	Pronouns:{" "}
	<a
		class="u-url highlightHover"
		href="https://en.wikipedia.org/wiki/Transgender#Transfeminine"
		class="u-pronoun"
		style="white-space:pre"
		id="pronounce"
	>
		<span class="p-x-pronoun-nominative">she</span>/<span class="p-x-pronoun-oblique">her</span>
	</a>
	<br />
	<article>
		<Marquee text="miruna! charli!" />
		<section>
			<span>
				<p>
					<a href="https://hood.pink/">miruna!</a>
				</p>
			</span>
			<figure>
				<Image width={512} height={512} src={miruna} alt="vennie!" class="wife-pfp" />
			</figure>
			<figure>
				<Image width={512} height={512} src={charli} alt="teto!" class="my-pfp" />
			</figure>
			<span>
				<p>(you're here)</p>
			</span>
		</section>
	</article>
    <article>
    	<Marquee text="about me!" />
		<section>
			<span>
				<p>I like software because hardware makes me remove my headphones.</p>
				<p>
					I'm very bad at summarising myself but I have been described by some friends as
					"calm but energetic" and that "i like horses."
				</p>
			</span>
		</section>
    </article>
</Page>
