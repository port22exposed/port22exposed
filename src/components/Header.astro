---
import {
	siGithub,
	siForgejo,
	siCodeberg,
	siGitlab,
	siDiscord,
	siBluesky,
	siMastodon,
} from "simple-icons"

import { Image } from 'astro:assets';
import pfp from "../media/pfp.webp";

import Social from "./Social.astro"
---

<style>
	nav {
		display: flex;
		flex-flow: wrap;
		align-items: center;
		gap: 1ch;
	}
	.u-uid {
		font-size: 28.5px;
		text-decoration: none;
		flex-grow: 1;
		margin: 0.5em 0px;
		display: flex;
		align-items: center;
	}

	.u-photo.profile-pic {
		width: 56px;
		height: 56px;
		border: 2px solid var(--accent);
		border-radius: 2.5%;
		margin-right: 0.5ch;
		vertical-align: middle;
	}
</style>

<nav>
	<a style="color:unset" href="/" class="u-url u-uid" rel="author">
		<Image
            src={pfp}
            alt="unknown gray haired character!"
            width={56}
            height={56}
            class="u-photo profile-pic"
        />
		<span><span class="p-name" style="color:var(--accent)">charli</span><wbr/>@port22.exposed</span>
	</a>
	{<!-- TODO: eventually using the lethal horse git logo would be cool but i'm lackin in time atm -->}
	<Social href="https://git.lethal.horse/port22exposed" icon={siForgejo} />
	<Social href="https://codeberg.org/port22exposed" icon={siCodeberg} />
	<Social href="https://github.com/port22exposed" icon={siGithub} color="#0FBF3E" />
	<Social href="https://gitlab.com/port22exposed" icon={siGitlab} />
	<Social href="https://discord.com/users/1318383159645311009" icon={siDiscord} />
	<Social href="https://infosec.exchange/@charli" icon={siMastodon} />
	<Social href="https://bsky.app/profile/did:plc:h2cmpplk6gsgo7awtoxygfro" icon={siBluesky} />
</nav>
