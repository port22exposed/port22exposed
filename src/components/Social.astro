---
import type { SimpleIcon } from "simple-icons"

interface Props {
	href: string
	icon: SimpleIcon
	color?: string
}
---

<style is:global>
	svg.social {
		vertical-align: middle;
		width: 2em;
		height: 2em;
	}
</style>

<a href={Astro.props.href} target="_blank" rel="me" class="u-url" style="display: block">
	<Fragment
		set:html={Astro.props.icon.svg.replace(
			`role="img"`,
			`role="img" class="social" fill="${Astro.props.color ?? `#${Astro.props.icon.hex}`}"`,
		)}
	/>
</a>
