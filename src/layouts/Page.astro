---
import { getImage } from "astro:assets";

import "../styles/normalize.css"
import "../styles/global.css"
import favicon from "/favicon.ico?url"
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

import bgOverlaySrc from "../media/background-overlay.png";

const bgOverlay = await getImage({
    src: bgOverlaySrc,
    width: 128,
    height: 128,
    format: "webp",
});

interface Props {
	title?: string
	description?: string
	bodyClass?: string
	children: any
}
const title = Astro.props.title ?? "charli"
const description = Astro.props.description
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="fediverse:creator" content="@charli@infosec.exchange">
		<link rel="icon" type="image/x-icon" href={favicon} />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ed9fbd" />
		<link rel="canonical" href={Astro.url.href} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="darkreader-lock" />

		<meta name="robots" content="noai, noimageai" />
		<meta name="tdm-reservation" content="1" />

		<title>{title}</title>
		<meta property="og:title" content={title} />
		<meta property="og:image" content="/media/pfp.webp" />
		<meta property="og:type" content="profile" />

		{Astro.props.description && (
			<meta name="description" content={description} />
			<meta property="og:description" content={description} />
		)}
	</head>

	<body style={`--bg-overlay: url('${bgOverlay.src}');`}>
		<Header />
		<main>
    		<slot />
		<main/>
		<Footer />
	</body>
</html>
